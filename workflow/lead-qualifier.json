{
  "name": "AI Lead Qualifier (Real Estate Demo)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Demo Realty — подбор недвижимости",
        "formDescription": "Ереван · Дубай · Москва. Оставьте заявку — подберём варианты под ваш бюджет и цели.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Имя",
              "fieldName": "name",
              "placeholder": "Анна",
              "requiredField": true
            },
            {
              "fieldLabel": "Телефон (WhatsApp)",
              "fieldName": "phone",
              "placeholder": "+374 91 123456",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "fieldName": "email",
              "placeholder": "anna@mail.com"
            },
            {
              "fieldLabel": "Город",
              "fieldType": "dropdown",
              "fieldName": "city",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Ереван"
                  },
                  {
                    "option": "Дубай"
                  },
                  {
                    "option": "Москва"
                  },
                  {
                    "option": "Пока не знаю"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Бюджет",
              "fieldType": "dropdown",
              "fieldName": "budget",
              "fieldOptions": {
                "values": [
                  {
                    "option": "до $100 000"
                  },
                  {
                    "option": "$100 000 – 300 000"
                  },
                  {
                    "option": "$300 000 – 700 000"
                  },
                  {
                    "option": "от $700 000"
                  },
                  {
                    "option": "Пока не знаю"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Цель покупки",
              "fieldType": "dropdown",
              "fieldName": "purpose",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Для жизни"
                  },
                  {
                    "option": "Инвестиции"
                  },
                  {
                    "option": "Пока не знаю"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Когда планируете покупку",
              "fieldType": "dropdown",
              "fieldName": "timeline",
              "fieldOptions": {
                "values": [
                  {
                    "option": "В ближайший месяц"
                  },
                  {
                    "option": "Через 1–3 месяца"
                  },
                  {
                    "option": "Через 3–6 месяцев"
                  },
                  {
                    "option": "Просто смотрю варианты"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Комментарий",
              "fieldType": "textarea",
              "fieldName": "message",
              "placeholder": "Например: 2 спальни, рядом с морем, рассрочка"
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Отправить заявку",
          "path": "realty-lead-demo",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Спасибо! Заявка получена — менеджер свяжется с вами в течение 15 минут."
            }
          },
          "ignoreBots": true
        }
      },
      "id": "9e3eab92-e462-46b8-bca0-df50818057cd",
      "name": "Lead Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        112
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=New real estate lead from the website form:\nName: {{ $json.name }}\nCity: {{ $json.city }}\nBudget: {{ $json.budget }}\nPurpose: {{ $json.purpose }}\nTimeline: {{ $json.timeline }}\nComment: {{ $json.message || '-' }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You qualify leads for an international real estate agency (Yerevan, Dubai, Moscow).\nReturn a score 0-100 and a temperature:\n- hot (70-100): plans to buy within 3 months AND has a known budget AND a clear purpose.\n- warm (40-69): 3-6 months, or budget/purpose unclear but real interest.\n- cold (0-39): \"just looking\", no budget and no timeline, or the comment looks like spam/test.\nA detailed, specific comment raises the score; budget from $300,000 raises it a little.\nsummary: one sentence in Russian with the key facts. next_step: one concrete action for the manager in Russian.\ninterest: a short Russian phrase describing what the client is looking for (city, property type, purpose, budget) to insert into a WhatsApp message; never put a full stop at the end.\ncity_en must be one of: Yerevan, Dubai, Moscow, Not sure. purpose_en must be one of: Living, Investment, Not sure."
            }
          ]
        },
        "batching": {}
      },
      "id": "6b41e39a-214b-431e-a0af-ae82422742a8",
      "name": "AI Lead Scoring",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        224,
        112
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 2000,
          "reasoningEffort": "low"
        }
      },
      "id": "e084830b-1ef3-4906-b58b-d83b5dce78f7",
      "name": "OpenAI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        128,
        320
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\"score\":82,\"temperature\":\"hot\",\"summary\":\"Инвестор, Дубай, $300–700k, покупка в ближайший месяц, хочет рассрочку.\",\"next_step\":\"Позвонить сегодня, прислать 3 объекта с рассрочкой в Dubai Marina.\",\"interest\":\"квартира в Дубае для инвестиций, бюджет $300 000 – 700 000\",\"city_en\":\"Dubai\",\"purpose_en\":\"Investment\"}"
      },
      "id": "707e7a36-f8f5-45f2-9a31-a5ab6ccfffc9",
      "name": "Lead Score Format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        368,
        336
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "l1",
              "name": "name",
              "value": "={{ String($(\"Lead Form\").item.json.name || '').trim() }}",
              "type": "string"
            },
            {
              "id": "l2",
              "name": "phone",
              "value": "={{ (() => { let d = String($(\"Lead Form\").item.json.phone || '').replace(/\\D/g, ''); if (d.startsWith('00')) d = d.slice(2); if (d.length === 9 && d.startsWith('0')) d = '374' + d.slice(1); if (d.length === 8) d = '374' + d; return '+' + d; })() }}",
              "type": "string"
            },
            {
              "id": "l3",
              "name": "email",
              "value": "={{ $(\"Lead Form\").item.json.email || \"\" }}",
              "type": "string"
            },
            {
              "id": "l4",
              "name": "budget",
              "value": "={{ $(\"Lead Form\").item.json.budget }}",
              "type": "string"
            },
            {
              "id": "l5",
              "name": "timeline",
              "value": "={{ $(\"Lead Form\").item.json.timeline }}",
              "type": "string"
            },
            {
              "id": "l6",
              "name": "message",
              "value": "={{ $(\"Lead Form\").item.json.message || \"\" }}",
              "type": "string"
            },
            {
              "id": "l7",
              "name": "score",
              "value": "={{ $json.output?.score ?? 50 }}",
              "type": "number"
            },
            {
              "id": "l8",
              "name": "temperature",
              "value": "={{ $json.output?.temperature ?? 'warm' }}",
              "type": "string"
            },
            {
              "id": "l9",
              "name": "summary",
              "value": "={{ $json.output?.summary ?? 'AI не смог оценить заявку, проверьте её вручную.' }}",
              "type": "string"
            },
            {
              "id": "l10",
              "name": "next_step",
              "value": "={{ $json.output?.next_step ?? 'Связаться с клиентом и уточнить запрос.' }}",
              "type": "string"
            },
            {
              "id": "l11",
              "name": "interest",
              "value": "={{ $json.output?.interest ?? 'подбор недвижимости' }}",
              "type": "string"
            },
            {
              "id": "l12",
              "name": "city",
              "value": "={{ $json.output?.city_en ?? 'Not sure' }}",
              "type": "string"
            },
            {
              "id": "l13",
              "name": "purpose",
              "value": "={{ $json.output?.purpose_en ?? 'Not sure' }}",
              "type": "string"
            },
            {
              "id": "l14",
              "name": "nameSafe",
              "value": "={{ String($(\"Lead Form\").item.json.name || '').trim().replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'})[c]) }}",
              "type": "string"
            },
            {
              "id": "l15",
              "name": "summarySafe",
              "value": "={{ String($json.output?.summary ?? 'AI не смог оценить заявку, проверьте её вручную.').replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'})[c]) }}",
              "type": "string"
            },
            {
              "id": "l16",
              "name": "nextStepSafe",
              "value": "={{ String($json.output?.next_step ?? 'Связаться с клиентом и уточнить запрос.').replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'})[c]) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
